{
	"name": "vit/slide",
	"title": "Slide",
	"category": "devphase",
	"icon": "smiley",
	"supports": {
		"align": false,
		"anchor": false,
		"color": {
			"text": true,
			"background": true
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
