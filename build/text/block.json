{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "create-block/test",
  "version": "0.1.0",
  "title": "Test Block",
  "category": "widgets",
  "icon": "smiley",
  "description": "Example block scaffolded with Create Block tool.",
  "supports": {
    "html": false,
    "align": [
      "wide"
    ]
  },
  "attributes": {
    "layout_variant": {
      "type": "array",
      "enum": [
        "text-left",
        "text-right"
      ],
      "default": "text-right"
    },
    "image_id": {
      "type": "number"
    },
    "image_url": {
      "type": "string"
    },
    "heading": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "align": {
      "type": "string",
      "default": "left"
    },
    "colorValue": {
      "type": "string",
      "default": "#000"
    },
    "textAlign": {
      "type": "string",
      "default": "left"
    },
    "toggle": {
      "type": "boolean",
      "default": true
    },
    "user": {
      "type": "string",
      "default": "a"
    },
    "title": {
      "type": "string"
    },
    "longTitle": {
      "type": "string"
    },
    "cont": {
      "type": "string"
    },
    "image": {
      "type": "integer"
    },
    "images": {
      "type": "array",
      "default": []
    },
    "page": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "default": []
    }
  },
  "textdomain": "cta-dynamic-block",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}